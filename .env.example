PUBLIC_BASE_URL=https://tools.gpthub.ru
APP_SECRET=generate-a-long-random-value
APP_VERSION=dev
GATEWAY_PORT=9080
UPSCALE_URL=https://api.gpthub.ru/upscale
BACKGROUND_URL=https://api.gpthub.ru/bgr1/process
# Optional CPU restoration endpoint; empty falls back to UPSCALE_URL.
ENHANCE_URL=
CLAMAV_REQUIRED=true
MAX_ACTIVE_JOBS_PER_IP=3
MAX_UPSCALE_OUTPUT_PIXELS=200000000
METRICS_API_KEY=replace-with-a-private-key
METRICS_RETENTION_DAYS=365
